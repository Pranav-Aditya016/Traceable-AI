from PIL import Image

tfrec_path = TFREC_DIR / "images.tfrecords"
print(f"Reading from: {tfrec_path}")

# First, inspect ONE record to see actual features
raw_ds = tf.data.TFRecordDataset([str(tfrec_path)])
print("\n=== Inspecting TFRecord structure ===\n")

for raw_record in raw_ds.take(1):
    example = tf.train.Example()
    example.ParseFromString(raw_record.numpy())
    feature_names = list(example.features.feature.keys())
    print(f"Available features: {feature_names}")
    
    # Show first feature values to debug
    for fname in feature_names[:3]:
        feat_type = example.features.feature[fname].WhichOneof('kind')
        print(f"  - {fname}: {feat_type}")
    break

# Use the features we know exist: 'label' and 'image_raw' (from original cells)
feature_description = {
    "label": tf.io.FixedLenFeature([], tf.int64),
    "image_raw": tf.io.FixedLenFeature([], tf.string),
}

def _parse_example(example_proto):
    features = tf.io.parse_single_example(example_proto, feature_description)
    image = tf.io.decode_jpeg(features["image_raw"], channels=3)
    label = features["label"]
    return image, label

N_SAMPLES = 300
raw_dataset = tf.data.TFRecordDataset([str(tfrec_path)])
parsed = raw_dataset.map(_parse_example)

count = 0
captions = []

for idx, (image, label) in enumerate(parsed.take(N_SAMPLES)):
    img_np = image.numpy()
    label_val = int(label.numpy())
    
    # Create filename using index
